# meteo-local: datos que sube el NAS (ADR 0020). Los lee la web pública Temps
# a Montflorit (meteo-montflorit.github.io, ADR 0028); la web antigua de
# jjdeharo.github.io/meteo-local ya solo redirige (ADR 0030). «setifempty»:
# subscripcio.php pone el suyo (ADR 0048).
<IfModule mod_headers.c>
  Header setifempty Access-Control-Allow-Origin "https://meteo-montflorit.github.io"
  Header merge Vary Origin
  Header set Cache-Control "no-cache, max-age=0"
</IfModule>
Options -Indexes
